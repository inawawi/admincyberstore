{
  "name": "cyber-store-nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue.bold,green.bold \"next dev --port 3000\" \"npm run dev:frontend\"",
    "dev:backend": "next dev --port 3000",
    "dev:frontend": "npm --prefix frontend run dev -- --port 3100",
    "ngrok": "ngrok http 3100 --host-header=rewrite",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env.local --test tests/*.test.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.542.0",
    "mysql2": "^3.14.4",
    "next": "16.3.3",
    "nodemailer": "^7.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-select": "^5.10.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}