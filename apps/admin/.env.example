# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database (gunakan user khusus, BUKAN root, di production)
# ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyber_store_v1
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=60

# ─────────────────────────────────────────────
# Auth & Encryption (wajib diisi, minimal 32 karakter)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────
AUTH_SECRET=
API_ENCRYPTION_KEY=

# Salt untuk obfuscation ID order — wajib diisi di production
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ID_CIPHER_SALT=

# Key untuk proteksi endpoint /api/health (opsional, tapi direkomendasikan)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
HEALTH_CHECK_KEY=

# ─────────────────────────────────────────────
# Media (path ke public/storage Laravel)
# ─────────────────────────────────────────────
MEDIA_ROOT=./public/storage

# ─────────────────────────────────────────────
# Midtrans Payment Gateway
# WAJIB: set MIDTRANS_IS_PRODUCTION=true di production!
# ─────────────────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─────────────────────────────────────────────
# RajaOngkir (Shipping)
# ─────────────────────────────────────────────
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter

# ─────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Cyber Store
