# Database existing dari aplikasi Laravel (tidak dibuat ulang oleh Next.js).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyber_store_v1
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# URL publik aplikasi Next.js.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=ganti-dengan-random-string-minimal-32-karakter
API_ENCRYPTION_KEY=

# Integrasi opsional (fitur memakai fallback aman bila belum diisi).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
FCM_SERVER_KEY=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Cyber Store

# Arahkan ke public/storage milik aplikasi Laravel agar foto lama tetap tampil.
# Sesuaikan path bila lokasi aplikasi berbeda.
MEDIA_ROOT=../cyber_store_api/public/storage
