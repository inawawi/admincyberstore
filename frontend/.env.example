# =============================================================================
#  CYBER STORE — Environment Variables
#  Salin file ini menjadi .env lalu isi nilainya sesuai environment.
#  Jangan pernah commit file .env ke repository!
# =============================================================================

# ─── Backend API ─────────────────────────────────────────────────────────────
# URL base API Laravel (tanpa trailing slash)
# Dev (Laragon) : http://cyber_store_api.test/api/v1
# Prod          : https://api.yourdomain.com/api/v1
NUXT_PUBLIC_API_BASE=http://cyber_store_api.test/api/v1

# URL base storage Laravel (tanpa trailing slash)
# Dev (Laragon) : http://cyber_store_api.test/storage
# Prod          : https://api.yourdomain.com/storage
NUXT_PUBLIC_STORAGE_BASE=http://cyber_store_api.test/storage

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Client ID saja yang ada di frontend. Client SECRET wajib hanya di backend Laravel!
NUXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
NUXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── Midtrans Payment Gateway ────────────────────────────────────────────────
# Sandbox    : https://app.sandbox.midtrans.com/snap/snap.js
# Production : https://app.midtrans.com/snap/snap.js
NUXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
NUXT_PUBLIC_MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY
